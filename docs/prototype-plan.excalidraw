    {
      "id": "phase1_head", "type": "text", "x": 102, "y": 225, "width": 250, "height": 28, "text": "Agree the boundary", "originalText": "Agree the boundary", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#c2410c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110013, "version": 1, "versionNonce": 110014, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
